        "GAMEART_BG_REMOVAL_MODEL": "birefnet.safetensors",
        "GAMEART_VLM_MODEL": "qwen3-vl:8b",
        "OLLAMA_URL": "http://127.0.0.1:11434"
      }
    }
  }
}
