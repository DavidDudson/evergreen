{
  "mcpServers": {
    "rust-analyzer": {
      "type": "stdio",
      "command": "mcp-language-server",
      "args": ["--workspace", "/home/ddudson/repos/evergreen", "--lsp", "rust-analyzer"]
    },
    "gameart": {
      "type": "stdio",
      "command": "gameart-mcp",
      "env": {
