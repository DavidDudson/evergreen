// Bigby's first quest. Offered the first time the player discusses Redeye
// with him; accepted via a follow-up choice on the same script.
//
// Flag conventions: `quest:<id>:offer`, `quest:<id>:accept`,
// `quest:<id>:milestone:<index>`. These are wired in
// `assets/dialogue/scripts/bigby.dialog.ron`.
Quest(
    id: "bigby.sick_animals",
    title_key: "quest.bigby.sick_animals.title",
    description_key: "quest.bigby.sick_animals.description",
    giver_key: "npc.bigby.name",
    offer_flag: "quest:bigby.sick_animals:offer",
    accept_flag: "quest:bigby.sick_animals:accept",
    milestones: [
        Milestone(
            label_key: "quest.bigby.sick_animals.milestone.0",
            flag: "quest:bigby.sick_animals:milestone:0",
        ),
        Milestone(
            label_key: "quest.bigby.sick_animals.milestone.1",
            flag: "quest:bigby.sick_animals:milestone:1",
        ),
        Milestone(
            label_key: "quest.bigby.sick_animals.milestone.2",
            flag: "quest:bigby.sick_animals:milestone:2",
        ),
    ],
    lore: QuestLore(
        body_key: "quest.bigby.sick_animals.lore",
    ),
    unlocks: [
        Alignment(Greenwoods),
    ],
)
